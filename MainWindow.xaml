<Window x:Class="CheckK2LowLatency.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows K2 Status Checker" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#1E1E1E" Foreground="#FFFFFF">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtHeader" Grid.Row="0" Text="Windows K2 Status Checker" 
                   FontSize="22" FontWeight="Bold" Foreground="#60CDFF" Margin="0,0,0,16"/>

        <!-- OS Build Info Box -->
        <Border x:Name="CardSysInfo" Grid.Row="1" CornerRadius="6" BorderThickness="1" 
                Background="#2B2B2B" BorderBrush="#333333" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="System Information" FontSize="14" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtOsCaption" Text="OS: Scanning..." FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtOsBuild" Text="Build: Scanning..." FontSize="13" Foreground="#CCCCCC" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Results Card -->
        <Border x:Name="CardTelemetry" Grid.Row="2" CornerRadius="6" BorderThickness="1" 
                Background="#2B2B2B" BorderBrush="#333333" Padding="16" Margin="0,0,0,16">
            <StackPanel x:Name="StatusContainer">
                <TextBlock Text="Feature Telemetry" FontSize="14" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,12"/>

                <!-- Presence Check -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtPresenceIcon" Text="⏳" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <TextBlock x:Name="TxtPresence" Grid.Column="1" Text="Checking feature presence..." FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <!-- Activation Check -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtActiveIcon" Text="⏳" FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <TextBlock x:Name="TxtActive" Grid.Column="1" Text="Checking activation status..." FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Notes / Requirements -->
        <Border x:Name="CardNotes" Grid.Row="3" CornerRadius="6" BorderThickness="1" 
                Background="#252525" BorderBrush="#333333" Padding="12" Margin="0,0,0,16">
            <TextBlock x:Name="TxtNotes" FontSize="11" Foreground="#888888" TextWrapping="Wrap" LineHeight="16">
                <Bold>Notes:</Bold> The K2 Low Latency Profile is only available on Insider Canary/Dev builds above ~26100.5000.
            </TextBlock>
        </Border>

        <!-- Action Button & Status Indicator -->
        <StackPanel Grid.Row="4">
            <Button x:Name="BtnRefresh" Content="Refresh Diagnostics" Height="36" Background="#0078D4" Foreground="White" 
                    BorderThickness="0" FontWeight="SemiBold" Click="BtnRefresh_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock x:Name="TxtLastUpdated" Text="" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>